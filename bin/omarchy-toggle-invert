#!/bin/bash

# omarchy:summary=Cycle color effects (invert / high-contrast) for the whole desktop or the focused window
# omarchy:args=<desktop|window> [on|off|invert|contrast|toggle|--status]
# omarchy:examples=omarchy toggle invert desktop | omarchy toggle invert window contrast

# Both scopes share Hyprland's single screen shader, so the state lives in
# default/hypr/invert.lua and this command only nudges it. That module writes the
# status file read back here.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
STATUS_FILE="$STATE_DIR/invert.status"

usage() {
  echo "Usage: omarchy-toggle-invert <desktop|window> [on|off|invert|contrast|toggle|--status]" >&2
}

MODE="$1"
ACTION="${2:-toggle}"

if [[ $MODE != "desktop" && $MODE != "window" ]]; then
  usage
  exit 1
fi

if [[ $ACTION == "--status" ]]; then
  effect=off
  if [[ -r $STATUS_FILE ]]; then
    raw="$(sed -n "s/^$MODE=//p" "$STATUS_FILE")"
    case $raw in
      invert|contrast) effect="$raw" ;;
      true)            effect=invert ;;   # accept a pre-effect-model status file
      *)               effect=off ;;
    esac
  fi

  enabled=false
  [[ $effect != "off" ]] && enabled=true

  jq -cn --arg mode "$MODE" --arg effect "$effect" --argjson enabled "$enabled" \
    '{mode:$mode, effect:$effect, enabled:$enabled}'
  exit 0
fi

mkdir -p "$STATE_DIR"

case $ACTION in
  on|invert) call="set('$MODE', 'invert')" ;;
  contrast)  call="set('$MODE', 'contrast')" ;;
  off)       call="set('$MODE', 'off')" ;;
  toggle)    call="cycle('$MODE')" ;;
  *)
    usage
    exit 1
    ;;
esac

hyprctl eval "require('default.hypr.invert').$call" >/dev/null
